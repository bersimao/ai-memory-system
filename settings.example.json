{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AI_MEMORY_HOME=\"$HOME/.claude\" python3 \"$HOME/.claude/hooks/memory-lifecycle.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AI_MEMORY_HOME=\"$HOME/.claude\" python3 \"$HOME/.claude/hooks/memory-lifecycle.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AI_MEMORY_HOME=\"$HOME/.claude\" python3 \"$HOME/.claude/hooks/memory-lifecycle.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env AI_MEMORY_HOME=\"$HOME/.claude\" python3 \"$HOME/.claude/hooks/memory-lifecycle.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
