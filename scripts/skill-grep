#!/usr/bin/env bash
# grep a skill's knowledge/reference file; on a miss, fall back to semantic
# search (mem/memsearch) scoped to that same skill — before mem, never after,
# so the common case (grep hits) pays zero extra latency.
#
# Why this exists: grep is exact-string, so a same-language paraphrase (e.g.
# not knowing which section title was used for a fact you can describe) is a
# false negative, not a real miss. `mem search` closes THAT gap (measured
# 2026-08-28: 8/9 real cross-references found by semantic search alone, same
# language on both sides).
#
# It does NOT close the cross-language gap (pt-BR query vs an EN-titled
# knowledge file, or vice versa) — tested and falsified 2026-08-29: even
# BGE-M3's raw dense embedding, with no BM25/hybrid involved at all, scored a
# same-language distractor higher than the correct cross-language match
# (0.71 vs 0.52 cosine). That's a property of the embedding model on this
# content, not a config knob. For that case the fix is still "retry the grep
# in the file's other documented language" — db/di SKILL.md already say so.
#
# It's also slow (~3-5s, embeddings model load) and not everyone who uses
# these skills has it installed — this is shipped in a team-shared skills
# repo (ia-skills), and `mem` is a personal ai-memory-system install, so most
# teammates simply won't have it. Checking for it first is a filesystem stat,
# not a subprocess spawn, so a machine without it pays nothing extra.
#
# Usage: skill-grep <file> <term>
#   Same shape as the `grep -in "<term>" <file>` calls already documented in
#   db/di/addon SKILL.md — this replaces that one command, not a new workflow.
#
# Exit codes (distinct on purpose — a fallback hit is a weaker signal than a
# grep hit, and the caller should treat it that way):
#   0  grep hit
#   10 grep missed, mem found something in this skill
#   1  grep missed, mem not installed (no fallback attempted)
#   2  grep missed, mem installed but found nothing relevant in this skill
#
# Every non-zero path also prints the other-language retry order (other_language),
# 10 included — see the comment there. 1 and 2 additionally list the file's
# sections when that listing would be an index (show_structure).
set -uo pipefail

usage() { echo "usage: skill-grep <file> <term>" >&2; exit 64; }
[ $# -eq 2 ] || usage
file=$1
term=$2
[ -f "$file" ] || { echo "skill-grep: no such file: $file" >&2; exit 64; }

# How many section titles to print before truncating — a listing is only cheap
# while it stays short (the measured db query library has 26).
toc_max=${SKILL_GREP_TOC_MAX:-60}

# Last resort on a total miss: stop guessing at synonyms and show the file's own
# structure, so the caller can pick a term that is provably IN the file.
#
# Why this beats translating the query (measured 2026-08-30; full numbers in the
# ai-memory-system topic `argos-translate-benchmark`): for a knowledge file whose
# entries are named sections, printing every title is 100% recall BY CONSTRUCTION
# — if the section exists, its title is in that list — at ~354 tokens for the
# 26-title db query library, ~5ms, and zero dependencies. Machine translation
# reached 27/30 only through a noisy any-token grep (median 13 junk lines) and got
# B1 jargon flatly wrong: "pedido de venda" -> "Request for sale" (it is Sales
# Order), "filiais" -> "subsidiaries" (Branches).
#
# It does NOT try to tell you the file's language, and neither should anything
# else here. These files are MIXED: menu-ids-reference.md is English prose at
# lines 3-29 and pt-BR menu rows from line 32 on. Any excerpt therefore reports
# the language of the excerpt, not of the part you were looking for — a sample
# that lands in the intro says "English" about a file whose rows are pt-BR. The
# earlier version of this script sampled rows for exactly that purpose and was
# only ever right by luck of the layout.
#
# The retry is driven by YOUR QUERY's language instead, which is known for
# certain because you wrote it: this corpus is pt-BR or en-US, so if the term
# missed, the other language is the one thing left to try. That is unconditional
# and needs no detection.

# A listing only helps if picking a title actually NARROWS the file. "Has
# headings" is the wrong test: menu-ids-reference.md has 3 of them for 923 lines,
# so listing them leaves the caller ~770 lines to search and tells them nothing.
# Measured across the real knowledge/ corpus (2026-08-30) the split is stark —
# sectioned files run 6-23 lines per section (tables-reference 6, useful-queries
# 23), flat dumps run 180-307 (objtype-servicetype-enums 180, menu-ids 307).
# 40 sits in that gap and is roughly "a section you would actually read".
max_lines_per_section=40

show_structure() {
  local n lines per
  n=$(grep -cE '^#{2,4} ' "$file")
  lines=$(wc -l < "$file")
  per=$(( n > 0 ? lines / n : lines ))
  [ "$n" -ge 3 ] && [ "$per" -le "$max_lines_per_section" ] || return 0

  # A COMPLETE list of titles is safe to print: absence from it really does mean
  # absence from the file, so it cannot mislead the way an excerpt can. A
  # TRUNCATED list carries no such guarantee — it is a prefix sample, and calling
  # it "the sections of this file" would repeat, in this branch, exactly the
  # part-implies-whole mistake the flat-file excerpt was deleted for. So the two
  # cases are labelled differently, and the truncated one says outright that
  # absence from it proves nothing.
  if [ "$n" -le "$toc_max" ]; then
    echo "skill-grep: all $n sections of this file — a complete list, so a title missing here is genuinely not in the file:"
    grep -nE '^#{2,4} ' "$file"
  else
    echo "skill-grep: the FIRST $toc_max of $n sections — an incomplete list, do NOT read absence into it:"
    grep -nE '^#{2,4} ' "$file" | head -"$toc_max"
    echo "            $((n - toc_max)) more not shown (raise SKILL_GREP_TOC_MAX to see them all)."
  fi
}

# Printed on EVERY path where the grep missed — including the one where `mem`
# returned a semantic hit, because that hit is explicitly a weak signal the
# caller is told to verify. A wrong-language grep that lands on a plausible-
# looking semantic match is the exact case where the retry gets skipped, so
# withholding the reminder there would withhold it when it matters most.
other_language() {
  echo "skill-grep: no grep hit for \"$term\". This corpus is pt-BR or en-US only — re-run with"
  echo "            the SAME term in the OTHER language before concluding it does not exist."
}

if grep -in -- "$term" "$file"; then
  exit 0
fi

# Overridable for tests; real use always wants the installed one.
mem=${SKILL_GREP_MEM:-"$HOME/.claude/scripts/mem"}
if [ ! -x "$mem" ]; then
  echo "skill-grep: no grep hit; mem not installed, skipping semantic fallback (see ai-memory-system to add it)"
  show_structure
  other_language
  exit 1
fi

# knowledge/<f>.md or references/<f>.md -> the skill root two levels up.
# Filtering fallback results to this directory keeps a miss in `db` from
# surfacing an unrelated hit from `di` or `addon` — the fallback still only
# answers for the skill you asked, it just stops being exact-string-only.
skill_root=$(cd "$(dirname "$(dirname "$file")")" && pwd)

# `mem` deliberately has no JSON output (see ai-memory-system/docs/retrieval-
# interface.md: it never forwards raw flags to the backend) — it prints
# "N. [score] hash  source" then an indented content-preview line per hit, or
# "(no results)". Parse that plain-text contract, not a machine format that
# doesn't exist.
text=$("$mem" search "$term" -k 10 -c curated 2>/dev/null)
if [ -z "$text" ]; then
  echo "skill-grep: no grep hit; mem search returned nothing (backend missing or query failed)"
  show_structure
  other_language
  exit 2
fi

hits=$(printf '%s\n' "$text" | python3 -c "
import re, sys
skill_root = sys.argv[1]
lines = sys.stdin.read().splitlines()
header = re.compile(r'^\d+\. \[([\d.]+)\] (\S+)  (.+)\$')
found = False
i = 0
while i < len(lines):
    m = header.match(lines[i])
    if m:
        score, chunk_hash, src = m.groups()
        preview = lines[i + 1].strip() if i + 1 < len(lines) else ''
        if src == skill_root or src.startswith(skill_root + '/'):
            found = True
            print(f'{float(score):.2f}  {src}')
            print(f'  {preview}')
            print(f'  (mem expand {chunk_hash})')
        i += 2
    else:
        i += 1
sys.exit(0 if found else 1)
" "$skill_root")
status=$?

if [ $status -eq 0 ] && [ -n "$hits" ]; then
  echo "skill-grep: no grep hit; semantic match in this skill (verify before relying on it):"
  printf '%s\n' "$hits"
  other_language
  exit 10
fi

echo "skill-grep: no grep hit; nothing relevant in this skill via semantic search either"
show_structure
other_language
exit 2
