#!/usr/bin/env bash
# llm-run — model-agnostic headless LLM invocation for the memory cron jobs.
# Usage: llm-run <tier> <prompt>
#   cheap — high-volume, low-risk extraction (distill.sh, backfill-daily-logs.sh)
#   smart — judgment work: deletion/merge decisions (curate.sh)
#
# This file IS the backend config: to switch CLI or model, edit the tier
# cases below and nothing else. Contract any backend command must honor:
#   - headless one-shot: takes the prompt as an argument, runs to completion, exits
#   - agentic file access: must be able to READ and EDIT the files named in the
#     prompt (paths under ~/.claude/) without interactive approval
#   - non-zero exit on failure (callers log-and-continue)
#   - EXIT 3 = account quota / spend limit exhausted. Distinct from "this call
#     failed": it means EVERY following call will fail the same way, so the
#     caller must ABORT the batch. On 08-24 the backfill treated the limit as an
#     ordinary failure and kept going: 57 identical calls, all dead on arrival.
# Per-backend notes: docs/model-agnostic.md in the memory-system repo
set -uo pipefail

tier="${1:?usage: llm-run <cheap|smart> <prompt>}"
prompt="${2:?usage: llm-run <cheap|smart> <prompt>}"

# PATH first: cron environments carry a minimal PATH, and claude installs
# land in different places (npm global, brew, ~/.local/bin). Hardcoding the
# last one broke every cron LLM call for anyone who installed differently.
CLAUDE="$(command -v claude || echo "$HOME/.local/bin/claude")"

# --setting-sources '' : do NOT load user/project/local settings for this call.
# Without it, every headless session inherits ALL session hooks — plugin hooks
# included. Measured on 08-24: a batch of 96 backfills fired 45 sessions with a
# Codex-gate verdict, i.e. one full CODE REVIEW per daily log written. The
# invisible cost was orders of magnitude larger than the haiku call itself.
# Not `--bare`: that also forces ANTHROPIC_API_KEY auth and breaks the OAuth
# from `claude login`. Verified: with this flag auth keeps working and no hook
# fires.
NOHOOKS=(--setting-sources '')

# --dangerously-skip-permissions: the ~/.claude/ sensitive-file gate ignores
# acceptEdits/permissions.allow, so headless edits there are silently denied
# without it. Claude-Code-specific; other CLIs have their own auto-approve flag.
# No `exec`: we need to INSPECT the output to tell "failed" from "quota ran
# out". With exec the process is replaced and there is nothing left to look at.
# Rate-limit backoff for when the server does NOT say how long to wait.
RATE_BACKOFF="${LLM_RUN_BACKOFF:-30}"
# Ceiling: past this, sleeping inside a cron is worse than aborting and letting
# the next round find the service already recovered.
RATE_MAX_WAIT="${LLM_RUN_MAX_WAIT:-300}"

# Extract the delay the SERVER asked for ("retry after 60s", "Retry-After: 60",
# "try again in 45 seconds"). Ignoring it means hammering (retrying before the
# deadline) or wasting time (waiting too long). Empty = the server didn't say.
advised_delay() {
  local t="$1" span num unit
  # Retry-After in HTTP-date format ("Wed, 21 Oct 2026 07:28:00 GMT") is NOT
  # seconds. Reading the "21" there gave 21s and retried too early — hammering.
  # Without a safe date conversion, better not to guess: fall to the default.
  case "$t" in
    *GMT*|*UTC*|*Mon,*|*Tue,*|*Wed,*|*Thu,*|*Fri,*|*Sat,*|*Sun,*) return 0 ;;
  esac
  span="$(printf '%s' "$t" \
    | grep -oiE '(retry[-_ ]?after|try again in|please wait|wait)[^0-9]{0,15}[0-9]+ ?(ms|secs?|seconds?|mins?|minutes?|hrs?|hours?|[smh])?' \
    | head -1)"
  [ -n "$span" ] || return 0
  # number: the LAST one in the span (the keyword has no digits, but if it
  # ever does, the value is always whatever comes last).
  num="$(printf '%s' "$span" | grep -oE '[0-9]+' | tail -1)"
  [ -n "$num" ] || return 0
  # unit: ignoring it turned "2 minutes" into 2 seconds.
  unit="$(printf '%s' "$span" | grep -oiE '(ms|secs?|seconds?|mins?|minutes?|hrs?|hours?|[smh])$' | tr 'A-Z' 'a-z')"
  case "$unit" in
    ms)                          num=$(( (num + 999) / 1000 )) ;;
    m|min|mins|minute|minutes)   num=$(( num * 60 )) ;;
    h|hr|hrs|hour|hours)         num=$(( num * 3600 )) ;;
  esac
  # "retry after 0" would sleep 0s = retry immediately = hammering.
  [ "$num" -lt 1 ] && num=1
  printf '%s' "$num"
}


run_tier() {
  local model="$1" out rc attempt=0
  while :; do
  out="$("$CLAUDE" -p "$prompt" --model "$model" --dangerously-skip-permissions "${NOHOOKS[@]}" 2>&1)"
  rc=$?
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] && return 0

  # Quota exhaustion only counts when the call REALLY failed. The output
  # includes the model's reply, and summaries mention "limit" all the time
  # ("well under the 1500-char limit", "rate-limit produces no log"): substring
  # matching on a successful call would abort the batch for no reason.
  # `cc_cli_limit_message` is the CLI's own marker in the URL and the most
  # specific anchor; the others cover the text variants (monthly, session, 5h).
  if [ "$rc" -ne 0 ]; then
    # (a) Unambiguous markers of the account's GLOBAL quota.
    case "$out" in
      *cc_cli_limit_message*|*"spend limit"*|*"usage limit"*) return 3 ;;
    esac
    # (b) Other "limit" mentions: only quota if it says WHEN it resets. A
    #     global limit always states the reset time ("5-hour limit reached ∙
    #     resets 3pm"); a PER-CALL limit does not — "context limit reached",
    #     "prompt too long", "rate limit, retry after 60s". Without this
    #     distinction, a single oversized transcript (MAX_CHARS rose to 250k on
    #     08-24) would abort the whole batch, when the right outcome is to fail
    #     just that day and move on.
    case "$out" in
      *limit*)
        case "$out" in
          *resets*|*"will reset"*|*"reset at"*) return 3 ;;
        esac
        ;;
    esac

    # (c) A rate limit is RETRYABLE — neither a failed call nor account quota.
    #     The service is asking us to slow down; moving straight to the next
    #     day is exactly the hammering it asked to stop. One wait and ONE retry
    #     cover the blip; if it persists, abort the batch instead of pounding.
    case "$out" in
      *"rate limit"*|*"Rate limit"*|*"rate_limit"*|*429*|*overloaded*|*Overloaded*|*"retry after"*|*"Retry-After"*)
        if [ "$attempt" -eq 0 ]; then
          attempt=1
          wait_s="$(advised_delay "$out")"
          if [ -n "$wait_s" ]; then
            if [ "$wait_s" -gt "$RATE_MAX_WAIT" ] 2>/dev/null; then
              echo "llm-run: server asked for ${wait_s}s (> ${RATE_MAX_WAIT}s) — aborting the batch instead of sleeping" >&2
              return 3
            fi
            echo "llm-run: rate limit — server asked for ${wait_s}s, honoring it" >&2
          else
            wait_s="$RATE_BACKOFF"
            echo "llm-run: rate limit with no stated delay — waiting ${wait_s}s" >&2
          fi
          sleep "$wait_s"
          continue
        fi
        echo "llm-run: persistent rate limit — aborting the batch instead of hammering the service" >&2
        return 3
        ;;
    esac
  fi
  return "$rc"
  done
}

case "$tier" in
  cheap)
    run_tier haiku
    ;;
  smart)
    # Pin the smart model explicitly — never let judgment work drift to a lesser tier.
    run_tier opus
    ;;
  *)
    echo "llm-run: unknown tier '$tier' (want cheap|smart)" >&2
    exit 2
    ;;
esac
