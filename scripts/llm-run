#!/usr/bin/env bash
# llm-run — model-agnostic headless LLM invocation for the memory cron jobs.
# Usage: llm-run <tier> <prompt>
#   cheap — high-volume, low-risk extraction (distill.sh, backfill-daily-logs.sh)
#   smart — judgment work: deletion/merge decisions (curate.sh)
#
# This file IS the backend config: to switch CLI or model, edit the tier
# cases below and nothing else. Contract any backend command must honor:
#   - headless one-shot: takes the prompt as an argument, runs to completion, exits
#   - agentic file access: must be able to READ and EDIT the files named in the
#     prompt (paths under ~/.claude/) without interactive approval
#   - non-zero exit on failure (callers log-and-continue)
#   - EXIT 3 = cota/limite de gasto estourado. Distinto de "essa chamada falhou":
#     significa que TODA chamada seguinte vai falhar igual, e o caller deve
#     ABORTAR o lote. Em 24/08 o backfill tratou o limite como falha comum e
#     seguiu tentando: 57 chamadas idênticas, todas mortas na porta.
# Per-backend notes: docs/model-agnostic.md in the memory-system repo
set -uo pipefail

tier="${1:?usage: llm-run <cheap|smart> <prompt>}"
prompt="${2:?usage: llm-run <cheap|smart> <prompt>}"

CLAUDE="$HOME/.local/bin/claude"

# --setting-sources '' : NÃO carregar user/project/local settings nesta chamada.
# Sem isto, toda sessão headless herda TODOS os hooks de sessão — inclusive os de
# plugin. Medido em 24/08: um lote de 96 backfills disparou 45 sessões com
# veredicto do gate do Codex, ou seja, uma REVISÃO DE CÓDIGO completa por daily
# log escrito. O custo invisível era ordens de grandeza maior que o haiku.
# Não usar `--bare`: ele também força auth por ANTHROPIC_API_KEY e quebra o OAuth
# do `claude login`. Verificado: com esta flag a auth continua funcionando e
# nenhum hook dispara.
NOHOOKS=(--setting-sources '')

# --dangerously-skip-permissions: the ~/.claude/ sensitive-file gate ignores
# acceptEdits/permissions.allow, so headless edits there are silently denied
# without it. Claude-Code-specific; other CLIs have their own auto-approve flag.
# Sem `exec`: precisamos INSPECIONAR a saída para distinguir "falhou" de
# "acabou a cota". Com exec o processo é substituído e não há como olhar.
# Backoff do rate limit quando o servidor NÃO diz quanto esperar.
RATE_BACKOFF="${LLM_RUN_BACKOFF:-30}"
# Teto: acima disso dormir num cron é pior que abortar e deixar a próxima
# rodada pegar o serviço já recuperado.
RATE_MAX_WAIT="${LLM_RUN_MAX_WAIT:-300}"

# Extrai o atraso que o SERVIDOR pediu ("retry after 60s", "Retry-After: 60",
# "try again in 45 seconds"). Ignorar isso é martelar (retentar antes do prazo)
# ou desperdiçar (esperar demais). Vazio = servidor não disse.
advised_delay() {
  local t="$1" span num unit
  # Retry-After em formato HTTP-date ("Wed, 21 Oct 2026 07:28:00 GMT") NÃO é
  # segundos. Ler o "21" ali dava 21s e retentava cedo demais — martelando.
  # Sem converter data com segurança, é melhor não adivinhar: cai no default.
  case "$t" in
    *GMT*|*UTC*|*Mon,*|*Tue,*|*Wed,*|*Thu,*|*Fri,*|*Sat,*|*Sun,*) return 0 ;;
  esac
  span="$(printf '%s' "$t" \
    | grep -oiE '(retry[-_ ]?after|try again in|please wait|wait)[^0-9]{0,15}[0-9]+ ?(ms|secs?|seconds?|mins?|minutes?|hrs?|hours?|[smh])?' \
    | head -1)"
  [ -n "$span" ] || return 0
  # número: o ÚLTIMO do trecho (a palavra-chave não tem dígitos, mas se tiver,
  # o valor é sempre o que vem por último).
  num="$(printf '%s' "$span" | grep -oE '[0-9]+' | tail -1)"
  [ -n "$num" ] || return 0
  # unidade: ignorá-la fazia "2 minutes" virar 2 segundos.
  unit="$(printf '%s' "$span" | grep -oiE '(ms|secs?|seconds?|mins?|minutes?|hrs?|hours?|[smh])$' | tr 'A-Z' 'a-z')"
  case "$unit" in
    ms)                          num=$(( (num + 999) / 1000 )) ;;
    m|min|mins|minute|minutes)   num=$(( num * 60 )) ;;
    h|hr|hrs|hour|hours)         num=$(( num * 3600 )) ;;
  esac
  # "retry after 0" dormiria 0s = retentar na hora = martelar.
  [ "$num" -lt 1 ] && num=1
  printf '%s' "$num"
}


run_tier() {
  local model="$1" out rc attempt=0
  while :; do
  out="$("$CLAUDE" -p "$prompt" --model "$model" --dangerously-skip-permissions "${NOHOOKS[@]}" 2>&1)"
  rc=$?
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] && return 0

  # Cota estourada só é considerada quando a chamada REALMENTE falhou. A saída
  # inclui a resposta do modelo, e resumos falam de "limite" o tempo todo
  # ("bem abaixo do limite de 1500 chars", "rate-limit não gera log"): casar
  # substring numa chamada bem-sucedida abortaria o lote sem motivo.
  # `cc_cli_limit_message` é o marcador do próprio CLI na URL e é o âncora mais
  # específico; os demais cobrem as variações de texto (mensal, sessão, 5h).
  if [ "$rc" -ne 0 ]; then
    # (a) Marcadores inequívocos de cota GLOBAL da conta.
    case "$out" in
      *cc_cli_limit_message*|*"spend limit"*|*"usage limit"*) return 3 ;;
    esac
    # (b) Demais "limit": só é cota se disser QUANDO reseta. Um limite global
    #     sempre informa o horário de reset ("5-hour limit reached ∙ resets 3pm");
    #     um limite POR CHAMADA não — "context limit reached", "prompt too long",
    #     "rate limit, retry after 60s". Sem esta distinção, um único transcript
    #     grande demais (MAX_CHARS subiu p/ 250k em 24/08) abortaria o lote
    #     inteiro, quando o certo é falhar só aquele dia e seguir.
    case "$out" in
      *limit*)
        case "$out" in
          *resets*|*"will reset"*|*"reset at"*) return 3 ;;
        esac
        ;;
    esac

    # (c) Rate limit é RETENTÁVEL — não é falha da chamada nem cota da conta. O
    #     serviço está pedindo para desacelerar; seguir direto para o próximo dia
    #     é justamente martelar. Uma espera e UMA nova tentativa cobrem o blip;
    #     se persistir, aborta o lote em vez de continuar batendo.
    case "$out" in
      *"rate limit"*|*"Rate limit"*|*"rate_limit"*|*429*|*overloaded*|*Overloaded*|*"retry after"*|*"Retry-After"*)
        if [ "$attempt" -eq 0 ]; then
          attempt=1
          wait_s="$(advised_delay "$out")"
          if [ -n "$wait_s" ]; then
            if [ "$wait_s" -gt "$RATE_MAX_WAIT" ] 2>/dev/null; then
              echo "llm-run: servidor pediu ${wait_s}s (> ${RATE_MAX_WAIT}s) — abortando o lote em vez de dormir" >&2
              return 3
            fi
            echo "llm-run: rate limit — servidor pediu ${wait_s}s, respeitando" >&2
          else
            wait_s="$RATE_BACKOFF"
            echo "llm-run: rate limit sem prazo informado — aguardando ${wait_s}s" >&2
          fi
          sleep "$wait_s"
          continue
        fi
        echo "llm-run: rate limit persistente — abortando o lote em vez de martelar o serviço" >&2
        return 3
        ;;
    esac
  fi
  return "$rc"
  done
}

case "$tier" in
  cheap)
    run_tier haiku
    ;;
  smart)
    # Pin the smart model explicitly — never let judgment work drift to a lesser tier.
    run_tier opus
    ;;
  *)
    echo "llm-run: unknown tier '$tier' (want cheap|smart)" >&2
    exit 2
    ;;
esac
